# Realtime voice services
GROQ_API_KEY=your_groq_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# Google Sheets target (the ID between /d/ and /edit in the sheet URL)
GOOGLE_SHEET_ID=your_google_spreadsheet_id

# Optional local caller identity and VoiceMem sidecar override
TEST_CALLER_ID=terminal_test_001
VOICEMEM_SIDECAR_URL=http://127.0.0.1:8766

# Explicit opt-in safeguards for the browser demo. Normal/local mode is unchanged.
PUBLIC_DEMO_MODE=false
PUBLIC_DEMO_MAX_CONCURRENT_SESSIONS=2
PUBLIC_DEMO_MAX_SESSION_SECONDS=600
# Required in demo mode; generate a private random value of at least 32 characters.
PUBLIC_DEMO_ACCESS_TOKEN=
PUBLIC_DEMO_START_RATE_LIMIT=5
PUBLIC_DEMO_START_RATE_WINDOW_SECONDS=60
# Leave empty for direct connections. Add only the socket IP of a trusted proxy.
PUBLIC_DEMO_TRUSTED_PROXY_IPS=
# Optional server-side gateway target; never use a VITE_ prefix for the access token.
PIPECAT_BACKEND_URL=http://127.0.0.1:7860
