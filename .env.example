# Realtime voice services
GROQ_API_KEY=your_groq_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# Google Sheets target (the ID between /d/ and /edit in the sheet URL)
GOOGLE_SHEET_ID=your_google_spreadsheet_id

